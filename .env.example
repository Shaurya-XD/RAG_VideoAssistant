# Copy this file to .env for local development. Never commit real API keys.
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=replace-with-a-supported-video-model
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=replace-with-your-key
GROQ_MODEL=replace-with-your-groq-model

# Optional: require this password before any video/API actions.
# Set a strong password for a private demo using your own API quota.
# APP_PASSWORD=replace-with-a-long-random-password
